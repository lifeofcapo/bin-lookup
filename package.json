{
  "name": "bin-lookup-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/bin-lookup",
    "build:demo": "npm run build -w apps/demo",
    "dev:demo": "npm run dev -w apps/demo",
    "test": "npm run test -w packages/bin-lookup",
    "build:data": "node packages/bin-lookup/scripts/build-data.mjs"
  }
}
